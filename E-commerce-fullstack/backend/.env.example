# Copy to backend/.env and fill in. NEVER commit the real .env file.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USERNAME=root
DB_PASSWORD=change-me

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=uploads

# First admin (created on first start if no admin exists). Pick your own password (min 8 chars).
ADMIN_EMAIL=admin@velure.local
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Administrator
